{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "api/**/*.ts",
    "packages/**/*.ts",
    "web/**/*.ts",
    "web/**/*.tsx",
    "worker/**/*.ts"
  ]
}
